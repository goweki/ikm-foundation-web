{
  "name": "ikm-foundation-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "next lint",
    "dev": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=500' NODE_ENV=development next dev",
    "build": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=500' NODE_ENV=production next build",
    "postbuild": "npm run copy-static",
    "copy-static": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "NODE_OPTIONS='--network-family-autoselection-attempt-timeout=500' NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@types/aos": "^3.0.7",
    "aos": "^2.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.13",
    "lucide-react": "^0.542.0",
    "next": "15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-paystack": "^6.0.0",
    "react-player": "^3.3.3",
    "react-slick": "^0.30.3",
    "react-social-icons": "^6.25.0",
    "react-toastify": "^11.0.5",
    "sass": "^1.94.2",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-animation-delay": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
